  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/adlutweb-daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/adlutweb-daily.err.log</string>
</dict>
</plist>
